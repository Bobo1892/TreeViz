{
  "manifest_version": 3,
  "name": "Tree Visualizer",
  "description": "Visualize binary trees from arrays",
  "version": "1.0",
  "action": {
    "default_popup": "hello.html",
    "default_icon": "node.png"
  },
  "permissions": ["tabs"],
  "web_accessible_resources": [
    {
      "resources": ["visualization.html", "popup.js", "popup.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
